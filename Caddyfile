# 透過環境變數注入網域，開源使用者可自行修改
{$DOMAIN_NAME:localhost} {
    
    # 全域安全標頭
    header {
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # API 路由轉發至 FastAPI 後端
    handle /api/* {
        reverse_proxy backend:8000
    }

    # 針對 AI 推論端點實施嚴格速率限制 (需搭配 caddy-rate-limit 模組)
    # 若無編譯模組，可依賴 FastAPI 內部的 slowapi 實作。此處展示 Caddy 原生語法概念：
    @ai_endpoint {
        path /api/v1/agent/chat*
    }
    handle @ai_endpoint {
        # 限制每個 IP 每分鐘最多 10 次請求，保護硬體不被癱瘓
        rate_limit {
            zone ai_chat {
                key {remote_host}
                events 10
                window 1m
            }
        }
        reverse_proxy backend:8000
    }

    # 前端靜態檔案轉發
    handle /* {
        reverse_proxy frontend:80
    }
}
