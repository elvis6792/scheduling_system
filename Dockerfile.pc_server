# 採用 NVIDIA 官方提供的 CUDA 基礎映像檔，確保包含 nvcc 編譯器與 cuBLAS 函式庫
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

# 設定環境變數
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    CMAKE_ARGS="-DGGML_CUDA=on" \
    FORCE_CMAKE=1

# 系統層級依賴與 Python 安裝
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3-pip \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 建立軟連結
RUN ln -s /usr/bin/python3.10 /usr/bin/python

# 設定工作目錄
WORKDIR /app

# 複製依賴清單並安裝
# 這裡會花比較多時間，因為 llama-cpp-python 會在容器內現場編譯 CUDA 版本
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 複製全量專案原始碼
COPY . .

# 開放 API 埠口
EXPOSE 8000

# 啟動腳本：自動執行資料庫初始化並啟動服務
# 這裡使用 bash 來串接初始化與啟動指令
CMD ["sh", "-c", "python -m app.core.init_db && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
