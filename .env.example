# JWT 安全金鑰與演算法 (建議使用隨機產生的長字串)
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256

# 初始管理員帳號 (僅在全新資料庫首次初始化時使用；留空則自動產生隨機密碼)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# LLM / OpenAI API 設定
openai_api_key=
llm_api_key=sk-local-dummy-key
llm_base_url=http://127.0.0.1:8080/v1

# LINE 整合設定
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
